# Build-time environment for the Cloudflare Worker that serves
# dev.unseenservant.se (see docs/DEPLOYMENT.md): a preview of this frontend
# against production's backend.
#
# Vite inlines every VITE_* value into the bundle during `npm run build:dev`, so
# this file - not the Worker's dashboard variables and not docker-compose - is
# the only place this environment is configured. An already-built bundle cannot
# be reconfigured at runtime.
#
# Safe to commit: public URLs only, no secrets.

# Same-origin: the Worker proxies /api/ and /images/ to production, so the app
# can keep using relative URLs. Set to production's URL instead and every call
# would be a cross-origin request that depends on production's CORS.
VITE_API_BASE_URL=

# The OAuth handshake runs on production. Its backend sets the redirect-origin
# cookie there and bounces the browser back here, which works because
# https://dev.unseenservant.se is listed in production's ALLOWED_ORIGINS. Left
# empty, the SPA would send oauth-init to this origin, where the Worker does not
# proxy it.
VITE_OAUTH_BASE_URL=https://unseenservant.se

# `dev` draws "Development environment — data may be reset.", the banner this
# origin already showed, and the honest wording when the backend is production.
# `prod` (the default in .env.production) hides the banner.
VITE_USER_NODE_ENV=dev
