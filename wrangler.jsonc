{
  // Cloudflare Worker that serves test.unseenservant.se, and - through
  // wrangler.dev.jsonc, which carries this same script with different vars -
  // dev.unseenservant.se. Both front one environment's nginx from the edge.
  //
  // Deploy: `npm run build:test && npx wrangler deploy` — the assets come from
  // the Vite build in ./dist. See docs/DEPLOYMENT.md for the full picture.
  //
  // Must match the Cloudflare project that owns the domain and the build
  // settings (Workers & Pages > unseenservant-frontend-staging): a mismatch
  // deploys a second Worker and leaves the configured one empty.
  "name": "unseenservant-frontend-staging",

  // Bump deliberately, after reading the compatibility notes. Workers Assets
  // and the array form of run_worker_first both need a recent enough date; if
  // `wrangler deploy` wants a newer one it names the value it needs.
  // Keep in step with wrangler.dev.jsonc.
  "compatibility_date": "2025-04-01",

  "main": "./worker/index.ts",

  // Runtime bindings, not build-time values: Cloudflare does not inject these
  // into the Vite build, and they deliberately avoid the VITE_ prefix so they
  // cannot be picked up as one. See "Variables and secrets" in
  // docs/DEPLOYMENT.md.
  "vars": {
    "UPSTREAM_HOST": "staging.unseenservant.se",
    "PUBLIC_HOST": "test.unseenservant.se"
  },

  "assets": {
    "directory": "./dist/",

    // Vue Router uses history mode, so a path that matches no asset has to
    // return index.html rather than a 404.
    "not_found_handling": "single-page-application",

    // Bound as env.ASSETS in worker/index.ts.
    "binding": "ASSETS",

    // Asset-first by default; only these reach the Worker script. The two
    // lists — here and PROXY_PREFIXES in worker/index.ts — describe the same
    // set of paths, so change both or neither.
    "run_worker_first": ["/api/*", "/images/*"]
  }
}
