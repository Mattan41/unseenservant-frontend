# Build-time environment for the Cloudflare Worker that serves
# test.unseenservant.se (see docs/DEPLOYMENT.md).
#
# Vite inlines every VITE_* value into the bundle during `npm run build:test`,
# so this file - not the Worker's dashboard variables and not docker-compose -
# is the only place this environment is configured. An already-built bundle
# cannot be reconfigured at runtime.
#
# Safe to commit: public URLs only, no secrets.

# Same-origin: the Worker proxies /api/ and /images/ to staging, so the app can
# keep using relative URLs.
VITE_API_BASE_URL=

# The OAuth handshake runs on staging. Its backend sets the redirect-origin
# cookie there and bounces the browser back here, which works because
# https://test.unseenservant.se is listed in staging's ALLOWED_ORIGINS. Left
# empty, the SPA would send oauth-init to this origin, where the Worker does not
# proxy it.
VITE_OAUTH_BASE_URL=https://staging.unseenservant.se

# `staging` has its own banner ("Staging environment — test data only, and it
# may be reset."), which is how this origin is told apart from production and
# from a local dev server at a glance. `prod` (the default in .env.production)
# hides the banner.
VITE_USER_NODE_ENV=staging
